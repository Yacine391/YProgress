# Web deployment: keep this ONLY on the server/Vercel. Never put the API key in EXPO_PUBLIC_*.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free
APP_URL=https://y-progress.vercel.app

# Optional for a native development build pointing to a separate AI server:
# EXPO_PUBLIC_AI_BASE_URL=https://your-ai-server.example.com
