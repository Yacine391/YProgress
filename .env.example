# Copie ce fichier en .env.local à la racine. Ne le mets jamais dans le ZIP ou git.
# Toutes ces valeurs sont lues CÔTÉ SERVEUR : aucune clé EXPO_PUBLIC_*.
OPENROUTER_API_KEY=sk-or-v1-remplace_par_ta_cle

# Modèle texte, et modèle photo distinct si souhaité.
# Le modèle par défaut ci-dessous accepte texte + images et dispose d'un quota gratuit limité.
# Ne choisis pour VISION_MODEL qu'un modèle acceptant les images ET response_format json_object.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free

# URL réellement déployée (utilisée pour l'attribution et CORS local).
APP_URL=http://localhost:8787

# Pour Expo natif / serveur séparé uniquement : URL du serveur API sans /api final.
# EXPO_PUBLIC_AI_BASE_URL=https://ton-serveur.example

# Local : npm run build:web puis node --env-file-if-exists=.env.local server/index.js
# Vercel : ajoute ces variables serveur aux Settings, puis redéploie.
# /api/health vérifie la CONFIGURATION ; seul un message ou une photo réussis vérifient le fournisseur.
