# Déploiement web : ces variables restent côté serveur/Vercel.
# Ne jamais mettre la clé dans une variable EXPO_PUBLIC_* : elle finirait dans le bundle.
OPENROUTER_API_KEY=sk-or-v1-remplace_par_ta_cle

# Facultatif. Sans valeur, le serveur utilise google/gemma-4-31b-it:free
# puis bascule automatiquement sur un modèle de secours s'il est saturé.
# Ne pas mettre openrouter/free : c'est un routeur aléatoire, la qualité
# et le style des réponses changent à chaque appel.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

APP_URL=https://y-progress.vercel.app

# Facultatif, pour une build native pointant vers un serveur IA séparé :
# EXPO_PUBLIC_AI_BASE_URL=https://ton-serveur-ia.example.com
